package main

import (
	"context"
	"flag"
	"log/slog"
	"net/http"
	"os"

	inertia "github.com/joetifa2003/inertigo"
	"{{ .GoPackageName }}/backend/models/pages"
	"github.com/joetifa2003/inertigo/props"
	"github.com/joetifa2003/inertigo/qjs"
	"github.com/joetifa2003/inertigo/vite"
)

func main() {
	isDev := flag.Bool("dev", false, "development mode")
	flag.Parse()

	bundler, err := vite.New(
		os.DirFS("node_modules/{{ .ProjectScope }}/frontend/dist"),
		vite.WithDevMode(*isDev),
	)
	must(err)

	i, err := inertia.New(
		bundler,
		inertia.WithLogger(slog.New(slog.NewTextHandler(os.Stdout, nil))),
		inertia.WithRootHtmlPathFS(os.DirFS("node_modules/{{ .ProjectScope }}/frontend"), "index.html"),
		inertia.WithSSR(true, func() (inertia.SSREngine, error) {
			return qjs.New(
				qjs.WithSrcPath("node_modules/{{ .ProjectScope }}/frontend/dist/server/ssr.js"),
				qjs.WithClusterSize(16),
			)
		}),
		// inertia.WithCSRF(true, false), // Enable CSRF if needed
	)
	must(err)

	mux := http.NewServeMux()

	mux.Handle(bundler.AssetPrefix(), bundler.Handler())

	mux.HandleFunc("/", func(w http.ResponseWriter, r *http.Request) {
		err = i.Render(w, r, "index", pages.Index{
			Message: "Hello from Go!",
			Reviews: props.NewDeferred(func(ctx context.Context) ([]string, error) {
				return []string{"Great", "Awesome", "Cool"}, nil
			}),
		})
		if err != nil {
			slog.Error(err.Error())
			http.Error(w, "internal server error", http.StatusInternalServerError)
			return
		}
	})

	i.Logger().Log(context.Background(), slog.LevelInfo, "starting server", slog.String("url", "http://localhost:8001"))

	http.ListenAndServe(":8001", i.Middleware(mux))
}

func must(err error) {
	if err != nil {
		panic(err)
	}
}
