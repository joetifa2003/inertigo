{
    "$schema": "https://turborepo.dev/schema.json",
    "extends": [
        "//"
    ],
    "tasks": {
        "build": {
            "dependsOn": [
                "^build",
                "build:frontend",
                "build:ssr"
            ]
        },
        "build:frontend": {
            "outputs": [
                "dist/",
                "!dist/server"
            ]
        },
        "build:ssr": {
            "outputs": [
                "dist/server"
            ]
        },
        "dev": {
            "dependsOn": [
                "^build"
            ]
        }
    }
}